# Réglages du serveur pour lancer stratdata sur sa machine.
#
#   cp .env.example .env     puis remplir .env (jamais versionné)
#   go run ./cmd/stratdata serve -web web/dist
#
# Le serveur lit .env dans le dossier où il est lancé. Une variable déjà
# définie dans le terminal l'emporte sur le fichier. En production, le même
# contenu va dans /etc/stratdata/stratdata.env (voir deploy/README.md).

# Adresse à laquelle on ouvre le site, sans barre finale (défaut :
# http://127.0.0.1:8642). La connexion Discord revient sur
# <adresse>/auth/callback : la même adresse doit figurer dans l'application
# Discord (OAuth2 > Redirects), et le site doit être ouvert à cette adresse.
STRATDATA_URL=

# Application OAuth2 du portail développeur Discord :
# https://discord.com/developers/applications > ton application > OAuth2.
STRATDATA_DISCORD_CLIENT_ID=
STRATDATA_DISCORD_CLIENT_SECRET=

# Identifiants Discord autorisés à créer des espaces, séparés par des
# virgules (vide : tout le monde). Ton identifiant : Discord > Paramètres >
# Avancés > Mode développeur, puis clic droit sur ton nom > Copier
# l'identifiant.
STRATDATA_CREATORS=

# Exploitant du site et contact, affichés sur la page de confidentialité.
STRATDATA_OPERATOR=
STRATDATA_CONTACT=
