# Copier vers /etc/stratdata/stratdata.env, puis :
#   chown root:root /etc/stratdata/stratdata.env && chmod 600 /etc/stratdata/stratdata.env
# Ne jamais versionner ce fichier une fois rempli.

# Adresse publique du site, sans barre finale. La connexion Discord revient
# sur STRATDATA_URL/auth/callback : la même adresse doit figurer dans l'application
# Discord (OAuth2 > Redirects).
STRATDATA_URL=https://stats.example.org

# Application OAuth2 du portail développeur Discord.
STRATDATA_DISCORD_CLIENT_ID=
STRATDATA_DISCORD_CLIENT_SECRET=

# Identifiants Discord autorisés à créer des espaces, séparés par des
# virgules (bêta fermée). Les autres rejoignent un espace par invitation.
# Ton identifiant : Discord > Paramètres > Avancés > Mode développeur, puis
# clic droit sur ton nom > Copier l'identifiant.
STRATDATA_CREATORS=

# Qui exploite le site et comment le joindre : affichés sur la page de
# confidentialité. Au sens du RGPD, l'exploitant est le responsable du
# traitement des données. Une adresse dédiée (alias) suffit.
STRATDATA_OPERATOR=
STRATDATA_CONTACT=
