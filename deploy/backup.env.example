# Copier vers /etc/stratdata/backup.env (root, chmod 600).
# Sans ce fichier, les sauvegardes restent sur le serveur : à éviter, une
# panne du disque emporterait tout.

# Dépôt restic hors du serveur. Exemples :
#   sftp:u123456@u123456.your-storagebox.de:/stratdata   (Hetzner Storage Box)
#   s3:https://s3.fr-par.scw.cloud/mon-bucket/stratdata  (Scaleway, Backblaze, OVH…)
RESTIC_REPOSITORY=

# Mot de passe de chiffrement du dépôt. Le garder aussi AILLEURS que sur le
# serveur (gestionnaire de mots de passe) : sans lui, les sauvegardes sont
# illisibles.
RESTIC_PASSWORD=

# Pour un dépôt S3 :
#AWS_ACCESS_KEY_ID=
#AWS_SECRET_ACCESS_KEY=
