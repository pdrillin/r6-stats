[Unit]
Description=Sauvegarde de r6-stats
After=r6-stats.service

[Service]
Type=oneshot
User=r6-stats
Group=r6-stats
# Dépôt restic et ses identifiants : voir backup.env.example.
EnvironmentFile=-/etc/r6-stats/backup.env
Environment=RESTIC_CACHE_DIR=/var/lib/r6-stats/.cache/restic
ExecStart=/opt/r6-stats/current/backup.sh
Nice=10
IOSchedulingClass=idle
