[Unit]
Description=Sauvegarde de stratdata
After=stratdata.service

[Service]
Type=oneshot
User=stratdata
Group=stratdata
# Dépôt restic et ses identifiants : voir backup.env.example.
EnvironmentFile=-/etc/stratdata/backup.env
Environment=RESTIC_CACHE_DIR=/var/lib/stratdata/.cache/restic
ExecStart=/opt/stratdata/current/backup.sh
Nice=10
IOSchedulingClass=idle
