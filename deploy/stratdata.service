# Service systemd du serveur stratdata.
# Installation : voir deploy/README.md.

[Unit]
Description=stratdata (serveur partagé)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=stratdata
Group=stratdata
# Secrets et réglages (Discord, adresse publique) : fichier lisible par root
# seulement, lu par systemd avant de lancer le serveur.
EnvironmentFile=/etc/stratdata/stratdata.env
# Le serveur n'écoute que sur la machine : Caddy reçoit le trafic HTTPS et le
# lui transmet.
ExecStart=/opt/stratdata/current/stratdata -data /var/lib/stratdata serve -addr 127.0.0.1:8642 -url ${STRATDATA_URL} -web /opt/stratdata/current/web
Restart=on-failure
RestartSec=5
# Laisse le temps de finir un envoi en cours avant l'arrêt.
TimeoutStopSec=150

# Données : base et replays bruts.
StateDirectory=stratdata
StateDirectoryMode=0750

# Durcissement : le serveur ne peut écrire que dans /var/lib/stratdata.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
UMask=0027

[Install]
WantedBy=multi-user.target
